/* ============================================================
   24. TEST: STUDENT-PROJECT SKILL MATCHING
   ============================================================ */

SELECT
    u.name AS student_name,
    p.title AS project_name,
    sk.skill_name,
    ss.proficiency_level AS student_level,
    ps.required_proficiency AS required_level
FROM students s
JOIN users u
    ON s.user_id = u.user_id
JOIN student_skills ss
    ON s.student_id = ss.student_id
JOIN skills sk
    ON ss.skill_id = sk.skill_id
JOIN project_skills ps
    ON ss.skill_id = ps.skill_id
JOIN projects p
    ON ps.project_id = p.project_id
WHERE ss.proficiency_level >= ps.required_proficiency;


/* ============================================================
   25. TEST: COUNT MATCHING SKILLS
   ============================================================ */

SELECT
    u.name AS student_name,
    p.title AS project_name,
    COUNT(*) AS matching_skills
FROM students s
JOIN users u
    ON s.user_id = u.user_id
JOIN student_skills ss
    ON s.student_id = ss.student_id
JOIN project_skills ps
    ON ss.skill_id = ps.skill_id
JOIN projects p
    ON ps.project_id = p.project_id
WHERE ss.proficiency_level >= ps.required_proficiency
GROUP BY
    s.student_id,
    u.name,
    p.project_id,
    p.title
ORDER BY matching_skills DESC;


