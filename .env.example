# ---------------------------------------------------------------
# SkillMatch — environment variables
# Copy to .env for local development, or set these in the Render
# dashboard (Environment Variables) when deploying.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# SERVER & SECURITY
# ---------------------------------------------------------------
# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Port Render or local environment assigns
PORT=5000

# 0 in production (disabled), 1 for local development only.
FLASK_DEBUG=0

# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=0

# Secret key used to sign session cookies.
# In production, must be a cryptographically random string (min 16 chars).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (no wildcards when cookies enabled)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# CSRF protection: 1 to enforce on all state-changing endpoints, 0 to bypass in test runs
CSRF_ENABLED=1

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
# Engine selection: 'sqlite', 'mysql', or 'postgres'
DB_ENGINE=sqlite

# PostgreSQL URL (leave unset on SQLite or MySQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# MySQL settings (used when DB_ENGINE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skillmatch_db

# Predefined demo data seeding (0 = clean database for real user inputs; 1 = seed demo accounts)
SEED_DEMO_DATA=0
