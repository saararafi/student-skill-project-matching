# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore, so it never reaches GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=student_skill_matching

# Any long random string — signs login session cookies (Day 2)
SECRET_KEY=change-this-to-something-long-and-random
