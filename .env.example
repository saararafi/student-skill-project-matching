# ---------------------------------------------------------------
# SkillMatch — environment variables
# Copy to .env for local development, or set these in the Render
# dashboard (Environment Variables) when deploying.
# ---------------------------------------------------------------

# Secret key used to sign session cookies.
# On Render this can be generated automatically.
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
# On Render, leave DATABASE_URL unset and attach a PostgreSQL
# instance - Render fills the value in for you (see render.yaml).
#
# For a local MySQL server, comment out DATABASE_URL and fill in
# the MySQL settings below.
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skillmatch_db

# ---------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------
# Port Render assigns (it sets this automatically).
PORT=5000

# 0 in production, 1 for local debugging.
FLASK_DEBUG=0

# Set to 1 when the site is served over HTTPS (Render does this).
SESSION_COOKIE_SECURE=1
